---
import { withBase } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import NowCard from '../components/NowCard.astro';
import SectionCard from '../components/SectionCard.astro';
import PostCard from '../components/PostCard.astro';
import LibraryCard from '../components/LibraryCard.astro';
import { SECTIONS, ENABLED_SECTIONS, config } from '../config';
import { t } from '../i18n';
import { getPosts, formatDate, isProjectDoc } from '../utils/content';

const [academic, insight, dailies, library, projects] = await Promise.all([
  getPosts('academic'),
  getPosts('insight'),
  getPosts('dailies'),
  getPosts('library'),
  getPosts('projects').then((all) => all.filter((p) => !isProjectDoc(p))),
]);

const latestInsight = insight.slice(0, 3);
const latestAcademic = academic.slice(0, 3);
const latestDailies = dailies.slice(0, 5);
const latestLibrary = library.slice(0, 3);

const counts = {
  academic: academic.length,
  insight: insight.length,
  dailies: dailies.length,
  library: library.length,
  projects: projects.length,
};
const rot = (i: number) => (i % 2 === 0 ? -0.5 : 0.5);
---

<BaseLayout>
  <Hero />

  <!-- 五个板块入口 -->
  {ENABLED_SECTIONS.length > 1 && <section class="container sections-grid">
    {ENABLED_SECTIONS.map((section, i) => <SectionCard {...section} count={counts[section.key]} unit={section.key === "dailies" ? t.common.units.entry : section.key === "library" ? t.common.units.item : section.key === "projects" ? t.common.units.project : t.common.units.post} index={4 + i} />)}
  </section>}

  <!-- Now 卡片 + 最新洞见 -->
  {(config.features.nowCard || config.sections.insight.enabled) && <section class="container section">
    <div class:list={['two-col','now-row',{'has-now':config.features.nowCard}]}>
      {config.features.nowCard && <div class="now-col">
        <NowCard index={8} />
      </div>}

      {config.sections.insight.enabled && <div class="panel reveal" style="--r:0.4deg; --i:9">
        <span class="panel-label">{t.home.latest(SECTIONS.insight.label)}</span>
        <div class="stack">
          {latestInsight.map((p, i) => (
            <PostCard
              href={withBase(`/insight/${p.id}/`)}
              title={p.data.title}
              date={p.data.date}
              description={p.data.description}
              rotate={rot(i)}
              index={10 + i}
              transitionName={`insight-${p.id}`}
            />
          ))}
          {latestInsight.length === 0 && <p class="muted">{t.common.empty}</p>}
        </div>
        <a href={withBase(SECTIONS.insight.href)} class="hand-btn more">{t.home.allOf(SECTIONS.insight.label)}</a>
      </div>}
    </div>
  </section>}

  <!-- 最新学术 + 日常快照 -->
  {(config.sections.academic.enabled || config.sections.dailies.enabled) && <section class="container section">
    <div class="two-col">
      {config.sections.academic.enabled && <div class="panel reveal" style="--r:-0.4deg; --i:12">
        <span class="panel-label">{t.home.latest(SECTIONS.academic.label)}</span>
        <div class="stack">
          {latestAcademic.map((p, i) => (
            <PostCard
              href={withBase(`/academic/${p.id}/`)}
              title={p.data.title}
              date={p.data.date}
              description={p.data.description ?? p.data.venue}
              badge={t.academic.kinds[p.data.kind]}
              rotate={rot(i + 1)}
              index={13 + i}
              transitionName={`academic-${p.id}`}
            />
          ))}
          {latestAcademic.length === 0 && <p class="muted">{t.common.empty}</p>}
        </div>
        <a href={withBase(SECTIONS.academic.href)} class="hand-btn more">{t.home.allOf(SECTIONS.academic.label)}</a>
      </div>}

      {config.sections.dailies.enabled && <div class="panel reveal" style="--r:0.3deg; --i:13">
        <span class="panel-label">{t.home.dailyPanel}</span>
        <ul class="daily-list">
          {latestDailies.map((d) => (
            <li>
              <a href={withBase(`/dailies/${d.id}/`)} class="daily-row">
                <time class="meta">{formatDate(d.data.date, 'short')}</time>
                <span class="daily-row-title" transition:name={d.data.title ? `dailies-${d.id}` : undefined}>
                  {d.data.title ?? d.data.description ?? t.home.untitled}
                </span>
                {d.data.mood && <span class="meta">{d.data.mood}</span>}
              </a>
            </li>
          ))}
          {latestDailies.length === 0 && <li class="muted">{t.home.noDailies}</li>}
        </ul>
        <a href={withBase(SECTIONS.dailies.href)} class="hand-btn more">{t.home.allOf(SECTIONS.dailies.label)}</a>
      </div>}
    </div>
  </section>}

  <!-- 资料库上新 -->
  {config.sections.library.enabled && <section class="container section">
    {config.sections.library.enabled && <div class="panel reveal" style="--r:-0.25deg; --i:15">
      <span class="panel-label">{t.home.libraryPanel}</span>
      <div class="lib-grid">
        {latestLibrary.map((l, i) => (
          <LibraryCard
            href={withBase(`/library/${l.id}/`)}
            title={l.data.title}
            type={l.data.type}
            url={l.data.url}
            author={l.data.author}
            rating={l.data.rating}
            status={l.data.status}
            summary={l.data.summary}
            rotate={rot(i)}
            index={16 + i}
            transitionName={`library-${l.id}`}
          />
        ))}
        {latestLibrary.length === 0 && <p class="muted">{t.home.emptyLibrary}</p>}
      </div>
      <a href={withBase(SECTIONS.library.href)} class="hand-btn more">{t.home.enterLibrary}</a>
    </div>}
  </section>}
</BaseLayout>

<style>
  .sections-grid {
    display: grid;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  @media (min-width: 640px) {
    .sections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sections-grid {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      gap: 1.1rem;
    }
  }
  .two-col:not(:has(> :nth-child(2))) { grid-template-columns:1fr; }
  .now-row:not(.has-now) { grid-template-columns:1fr; }
  .two-col {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .now-row {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
  .now-col {
    padding-top: 1.25rem;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .lib-grid {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .lib-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .more {
    margin-top: 1.5rem;
  }
  .daily-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .daily-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border: 2px dashed var(--pencil-25);
    border-radius: var(--radius-wobble-sm);
    transition: all 0.12s ease;
  }
  .daily-row:hover {
    border-style: solid;
    border-color: var(--pencil);
    background: var(--postit);
    transform: rotate(-0.5deg);
  }
  .daily-row-title {
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
