---
import { withBase } from '../../utils/url';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getArticlePaths, articleContext, articleNeighbor } from '../../utils/articles';

export async function getStaticPaths() {
  return getArticlePaths('insight');
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;

const context = await articleContext(post);
---

<PostLayout
  commentId={post.id}
  comments={d.comments}
  draft={d.draft}
  section="insight"
  transitionName={`insight-${post.id}`}
  title={d.title}
  description={d.description}
  date={d.date}
  updated={d.updated}
  tags={d.tags}
  image={d.cover}
  headings={headings}
  {...context}
  prev={articleNeighbor(prev)}
  next={articleNeighbor(next)}
>
  {d.cover && <img src={withBase(d.cover)} alt="" class="cover" />}
  <Content />
</PostLayout>

<style>
  .cover {
    margin-bottom: 2rem;
  }
</style>
