---
import { withBase } from '../../utils/url';
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getArticlePaths, articleContext, articleNeighbor } from '../../utils/articles';

export async function getStaticPaths() {
  return getArticlePaths('academic');
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const links = d.links ?? {};
const linkList = [
  ['PDF', links.pdf],
  ['arXiv', links.arxiv],
  ['DOI', links.doi],
  ['Code', links.code],
  ['Slides', links.slides],
  ['Site', links.site],
].filter(([, url]) => url) as [string, string][];

const context = await articleContext(post);
---

<PostLayout
  commentId={post.id}
  comments={d.comments}
  draft={d.draft}
  section="academic"
  transitionName={`academic-${post.id}`}
  title={d.title}
  description={d.description}
  date={d.date}
  updated={d.updated}
  tags={d.tags}
  headings={headings}
  {...context}
  prev={articleNeighbor(prev)}
  next={articleNeighbor(next)}
>
  <div slot="extra" class="paper-meta">
    {d.authors && <p class="authors">{d.authors.join(', ')}</p>}
    {
      (d.venue || d.year) && (
        <p class="venue">
          {d.venue}
          {d.year && <span> · {d.year}</span>}
        </p>
      )
    }
    {
      linkList.length > 0 && (
        <div class="links">
          {linkList.map(([label, url]) => (
            <a href={withBase(url)} target="_blank" rel="noopener" class="hand-btn small">
              {label}
            </a>
          ))}
        </div>
      )
    }
  </div>

  <Content />

  {
    d.bibtex && (
      <details class="bibtex">
        <summary>BibTeX</summary>
        <pre><code>{d.bibtex.trim()}</code></pre>
      </details>
    )
  }
</PostLayout>

<style>
  .paper-meta {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .authors {
    margin: 0;
    font-weight: 700;
  }
  .venue {
    margin: 0;
    color: var(--pencil-60);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .bibtex {
    margin-top: 2.5rem;
  }
  .bibtex summary {
    cursor: pointer;
    font-weight: 700;
  }
</style>
