---
import { t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import Archive from '../components/Archive.astro';
---

<BaseLayout title={t.archive.title} description={t.archive.desc}>
  <section class="container section">
    <span class="postit reveal" style="--i:0">{t.archive.badge}</span>
    <h1 class="page-title reveal" style="--i:1">{t.archive.title}</h1>
    <p class="page-desc reveal" style="--i:2">{t.archive.desc}</p>
    <div class="reveal" style="--i:3">
      <Archive />
    </div>
  </section>
</BaseLayout>
