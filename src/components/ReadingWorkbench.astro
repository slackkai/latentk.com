---
import BookmarkButton from './BookmarkButton.astro';
interface Props { path: string; title: string; section: string; }
const { path, title, section } = Astro.props;
---
<section class="reading-workbench" id="reading-workbench" aria-label="阅读工作台" data-pagefind-ignore>
  <div class="reading-controls">
    <BookmarkButton path={path} title={title} section={section} />
    <button class="hand-btn small" id="reader-focus" type="button" aria-pressed="false">专注阅读</button>
    <label>字号<select id="reader-size"><option value="standard">标准</option><option value="large">大字</option></select></label>
    <label>行宽<select id="reader-width"><option value="normal">舒展</option><option value="narrow">紧凑</option></select></label>
  </div>
  <p class="meta storage-note" data-storage-note>仅保存在当前浏览器，不同步账号。</p>
  <div class="reading-resume" id="reading-resume" hidden>
    <span id="reading-resume-label"></span>
    <div class="resume-actions"><button class="hand-btn small" type="button" id="reader-continue">继续阅读 →</button><button class="reader-start" type="button" id="reader-start">从头阅读</button></div>
  </div>
  <span class="sr-only" id="reader-announcement" aria-live="polite"></span>
</section>
<style>
  .reading-workbench { position:sticky;top:4.4rem;z-index:15;max-width:var(--max-w-prose);margin:0 auto 2rem;padding:.8rem 1rem;background:var(--paper-2);border:2px dashed var(--pencil-25);border-radius:var(--radius-wobble-sm);box-shadow:var(--shadow-soft); }
  .reading-controls,.resume-actions { display:flex;flex-wrap:wrap;align-items:center;gap:.6rem; }
  .reading-controls label { display:flex;align-items:center;gap:.4rem;font-size:.85rem; }
  .reading-controls select { min-width:0;font:inherit;color:var(--pencil);background:var(--paper);border:1px solid var(--pencil-25);border-radius:5px;padding:.2rem .35rem; }
  .reading-controls button[aria-pressed='true'] { background:var(--postit); }
  .storage-note { margin:.55rem 0 0;font-size:.75rem; }
  .reading-resume { display:flex;align-items:center;justify-content:space-between;gap:.65rem;flex-wrap:wrap;border-top:1px dashed var(--pencil-25);margin-top:.75rem;padding-top:.75rem;font-size:.95rem; }
  .reading-resume[hidden] { display:none; }
  .reader-start { color:var(--pen);text-decoration:underline;text-underline-offset:3px;font-size:.85rem; }
  @media(max-width:479px) { .reading-workbench { padding:.65rem .75rem; } .reading-controls { gap:.5rem; } .storage-note { font-size:.72rem; } }
</style>
<script src="../scripts/reading-workbench.ts"></script>
