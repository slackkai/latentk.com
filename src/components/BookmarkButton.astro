---
import { readingPath } from '../utils/reading-state.mjs';
interface Props { path: string; title: string; section: string; }
const { path, title, section } = Astro.props;
---
<button class="hand-btn small bookmark-button" type="button" data-bookmark-path={readingPath(path)} data-bookmark-title={title} data-bookmark-section={section} aria-pressed="false" data-pagefind-ignore>
  <span data-bookmark-label>加入稍后读</span>
</button>
<style>
  .bookmark-button[aria-pressed='true'] { background: var(--postit); }
  .bookmark-button { max-width: 100%; }
</style>
