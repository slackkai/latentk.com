---
import { config } from '../config';
import { t } from '../i18n';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/markdown.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  searchIndex?: boolean;
}
const { searchIndex = false, ...head } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const section = Astro.url.pathname.slice(base.length).split('/')[1];
const hiddenSection = Object.hasOwn(config.sections, section) && !config.sections[section as keyof typeof config.sections].enabled;
const noindex = hiddenSection || section === '404' || section === 'drafts' || section === 'lab' || (section === 'guestbook' && !config.features.guestbook);
---

<!doctype html>
<html lang={config.lang === "en" ? "en" : config.htmlLang} data-default-palette={config.defaultPalette}>
  <head>
    <BaseHead {...head} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <ClientRouter />
  </head>
  <body data-viewer-labels={JSON.stringify(t.md.viewer)} data-note-read={t.md.readNote} data-note-expand={t.md.note} data-code-copy={String(config.features.codeCopy)} data-image-zoom={String(config.features.imageZoom)} data-copy-failed={t.md.copyFailed} data-image-label={t.md.zoom} data-image-close={t.md.closeImage}>
    <a class="skip sr-only" href="#main">{t.common.skipToContent}</a>
    <Header />
    <main id="main" transition:name="main" data-pagefind-body={searchIndex && !noindex || undefined} data-pagefind-ignore={noindex || undefined}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/prose';
    </script>
  </body>
</html>
